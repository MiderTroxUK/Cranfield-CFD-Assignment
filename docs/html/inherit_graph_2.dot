digraph "Graphical Class Hierarchy"
{
 // INTERACTIVE_SVG=YES
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="Scheme",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_scheme.html",tooltip="Base class for numerical schemes."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="CrankNicholson_Scheme",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_crank_nicholson___scheme.html",tooltip="Implements the Crank-Nicholson implicit numerical scheme."];
  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="DufortFrankel_Scheme",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_dufort_frankel___scheme.html",tooltip="Implements the Dufort-Frankel explicit numerical scheme."];
  Node0 -> Node3 [id="edge3_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="Laasonen_Scheme",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_laasonen___scheme.html",tooltip="Implements the Laasonen implicit numerical scheme."];
  Node0 -> Node4 [id="edge4_Node000000_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="Richardson_Scheme",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_richardson___scheme.html",tooltip="Implements the Richardson explicit numerical scheme."];
}
